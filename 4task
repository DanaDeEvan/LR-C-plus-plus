#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

const int N = 10;

int main() {
    srand(time(NULL));

    int a[N], A, count = 0;

    for (int i = 0; i < N; i++) {
        a[i] = rand() % 100;
        cout << a[i] << " ";
    }

    cout << "\nEnter number A: ";
    cin >> A;

    for (int i = 0; i < N; i++) {
        if (a[i] > A) {
            count++;
        }
    }

    cout << "Number of elements greater than A: " << count;

    return 0;
}
