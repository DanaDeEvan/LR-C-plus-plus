#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;
int main() {
    const int m = 6, n = 4;
    int a[m][n];

    srand(time(NULL));

    for (int i = 0; i < m; i++)
        for (int j = 0; j < n; j++)
            a[i][j] = rand() % 30;

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++)
            cout << setw(4) << a[i][j];
        cout << endl;
    }

    for (int j = 0; j < n; j++) {
        int count = 0;
        for (int i = 0; i < m; i++)
            if (a[i][j] % 2 == 0)
                count++;

        cout << "Even numbers in column " << j << ": " << count << endl;
    }

    return 0;
}
