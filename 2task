#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter array size: ";
    cin >> n;

    int a[n];

    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int max = a[0];
    int maxIndex = 0;

    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
            maxIndex = i;
        }
    }

    for (int i = 0; i < maxIndex; i++) {
        if (a[i] < 0) {
            a[i] = 0;
        }
    }

    cout << "\nResult:\n";
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }

    return 0;
}
