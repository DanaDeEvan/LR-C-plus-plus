#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));

    int n;
    cout << "Введіть кількість елементів: ";
    cin >> n;

    double* arr = new double[n];

    int positive = 0;
    int negative = 0;

    for (int i = 0; i < n; i++) {
        arr[i] = -2 + (double)rand() / RAND_MAX * 4;
    }

    cout << "Масив:\n";

    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";

        if (arr[i] > 0)
            positive++;
        else if (arr[i] < 0)
            negative++;
    }

    cout << "\nКількість додатних чисел: " << positive << endl;
    cout << "Кількість від'ємних чисел: " << negative << endl;

    delete[] arr;

    return 0;
}
