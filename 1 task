#include <iostream>
#include <ctime>

using namespace std;

int main() {
    const int n = 5;
    int array[n][n];

    srand(time(0));

    int* p = &array[0][0];
    int even = 0;
    int odd = 0;

    for (int i = 0; i < n * n; i++) {
        *(p + i) = rand() % 100;

        if (*(p + i) % 2 == 0)
            even++;
        else
            odd++;
    }

    cout << "Array:" << endl;

    p = &array[0][0];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout.width(4);
            cout << *(p + i * n + j);
        }
        cout << endl;
    }

    cout << endl;

    cout << "Main diagonal: ";

    for (int i = 0; i < n; i++) {
        cout << *(p + i * n + i) << " ";
    }

    cout << endl;

    cout << "Secondary diagonal: ";

    for (int i = 0; i < n; i++) {
        cout << *(p + i * n + (n - 1 - i)) << " ";
    }

    cout << endl;

    cout << "Even elements: " << even << endl;
    cout << "Odd elements: " << odd << endl;

    return 0;
}
