#include <iostream>
#include <ctime>

using namespace std;

struct Date {
    int year;
    int month;
    int day;
};

bool isLeap(int year) {
    return ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0);
}

int monthLength(int year, int month) {
    int days[] = {31,28,31,30,31,30,31,31,30,31,30,31};

    if (month == 2 && isLeap(year))
        return 29;

    return days[month - 1];
}

Date today() {
    time_t t = time(NULL);
    tm tl = *localtime(&t);

    Date d;

    d.year = tl.tm_year + 1900;
    d.month = tl.tm_mon + 1;
    d.day = tl.tm_mday;

    return d;
}

int daysBetween(Date birth, Date current) {
    int days = 0;

    for (int y = birth.year; y < current.year; y++) {
        if (isLeap(y))
            days += 366;
        else
            days += 365;
    }

    for (int m = 1; m < birth.month; m++) {
        days -= monthLength(birth.year, m);
    }

    days -= birth.day;

    for (int m = 1; m < current.month; m++) {
        days += monthLength(current.year, m);
    }

    days += current.day;

    return days;
}

int main() {
    Date birth;

    cout << "Введіть дату народження (рік місяць день): ";
    cin >> birth.year >> birth.month >> birth.day;

    Date current = today();

    cout << "Поточна дата: ";
    cout << current.year << "-" << current.month << "-" << current.day << endl;

    cout << "Кількість днів: " << daysBetween(birth, current) << endl;

    return 0;
}
