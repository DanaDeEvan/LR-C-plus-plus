#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a = 1;
    double b = 1.201;

    double log1 = log(a / b);
    double log2 = log(b / a);
    double angle = (a + b) * M_PI / 10;

    double sinPart = sin(angle);
    double cosPart = cos(angle);

    double y = 0.7 * log1 * pow(sinPart, 2) + 0.8 * log2 * pow(cosPart, 2);
    y = pow(y, 1.5);

    cout << "Result y = " << y << endl; 

    return 0;
}
