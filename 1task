#include <iostream>
using namespace std;

int main() {
    const int m = 12;
    int a[m];

    cout << "Enter 12 integers:\n";
    for (int i = 0; i < m; i++) {
        cin >> a[i];
    }

    for (int i = 0; i < m - 1; i++) {
        for (int j = 0; j < m - 1 - i; j++) {
            if (a[j] > a[j + 1]) {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    cout << "\nArray in ascending order:\n";
    for (int i = 0; i < m; i++) {
        cout << a[i] << " ";
    }

    cout << "\n\nArray in descending order:\n";
    for (int i = m - 1; i >= 0; i--) {
        cout << a[i] << " ";
    }

    return 0;
}
