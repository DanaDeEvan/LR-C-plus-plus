#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, h, x, y;

    cout << "Enter a: ";
    cin >> a;
    cout << "Enter b: ";
    cin >> b;
    cout << "Enter step h: ";
    cin >> h;

    x = a;

    cout << "----------------------" << endl;
    cout << "|   X   |     Y      |" << endl;
    cout << "----------------------" << endl;

    while (x <= b) {
        y = x + 2 * sin(x);

        cout << "| " << x << " | " << y << " |" << endl;

        x += h;
    }

    cout << "----------------------" << endl;

    return 0;
}
