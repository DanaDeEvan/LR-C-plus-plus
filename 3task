#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;
int main() {
    const int m = 5, n = 7;
    int a[m][n];

    srand(time(NULL));

    for (int i = 0; i < m; i++) {
        int sum = 0;
        for (int j = 0; j < n; j++) {
            a[i][j] = rand() % 20;
            cout << setw(4) << a[i][j];
            sum += a[i][j];
        }
        cout << " | Row sum: " << sum << endl;
    }

    return 0;
}
