#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

const int N = 10;

int main() {
    srand(time(NULL));

    int a[N];

    for (int i = 0; i < N; i++) {
        a[i] = rand() % 100 - 50;
        cout << a[i] << " ";
    }
    cout << endl;

    int min = a[0], max = a[0];
    int minIndex = 0, maxIndex = 0;

    for (int i = 1; i < N; i++) {
        if (a[i] < min) {
            min = a[i];
            minIndex = i;
        }
        if (a[i] > max) {
            max = a[i];
            maxIndex = i;
        }
    }

    swap(a[minIndex], a[maxIndex]);

    cout << "After swapping:" << endl;
    for (int i = 0; i < N; i++) {
        cout << a[i] << " ";
    }

    return 0;
}
