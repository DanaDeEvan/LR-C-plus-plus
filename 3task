#include <iostream>
using namespace std;

int main() {
    float x, y;

    cout << "Enter coordinates of the point (x, y): ";
    cin >> x >> y;

    if ( (x >= -1 && x <= 0 && y >= 0 && y <= 1) || 
         (x >= 0 && x <= 1 && y >= -1 && y <= 0) ) {
        cout << "The point is inside the shaded area." << endl;
    } else {
        cout << "The point is outside the shaded area." << endl;
    }

    return 0;
}
