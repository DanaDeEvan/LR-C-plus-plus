#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

const int N = 10;

int main() {
    srand(time(NULL));

    int a[N];

    for (int i = 0; i < N; i++) {
        a[i] = rand() % 100;
        cout << a[i] << " ";
    }

    int max = a[0], secondMax = a[1];
    if (secondMax > max) swap(max, secondMax);

    for (int i = 2; i < N; i++) {
        if (a[i] > max) {
            secondMax = max;
            max = a[i];
        } else if (a[i] > secondMax) {
            secondMax = a[i];
        }
    }

    cout << "\nSecond largest element: " << secondMax;

    return 0;
}

