#include <iostream>
#include <string>

using namespace std;

class FlightBooking {
public:
    FlightBooking(int id, int capacity, int reserved);

    void printStatus();

    bool reserveSeats(int number_of_seats);

    bool cancelReservations(int number_of_seats);

private:
    int id;
    int capacity;
    int reserved;
};

FlightBooking::FlightBooking(int id, int capacity, int reserved) {
    this->id = id;
    this->capacity = capacity;

    int maxReserved = capacity * 105 / 100;

    if (reserved < 0)
        this->reserved = 0;
    else if (reserved > maxReserved)
        this->reserved = maxReserved;
    else
        this->reserved = reserved;
}

void FlightBooking::printStatus() {
    int percentage = reserved * 100 / capacity;

    cout << "Flight " << id << " : "
         << reserved << "/" << capacity
         << " (" << percentage << "%) seats reserved" << endl;
}

bool FlightBooking::reserveSeats(int number_of_seats) {
    int maxReserved = capacity * 105 / 100;

    if (reserved + number_of_seats > maxReserved)
        return false;

    reserved += number_of_seats;

    return true;
}

bool FlightBooking::cancelReservations(int number_of_seats) {
    if (reserved - number_of_seats < 0)
        return false;

    reserved -= number_of_seats;

    return true;
}

int main() {
    int reserved = 0;
    int capacity = 0;

    cout << "Provide flight capacity: ";
    cin >> capacity;

    cout << "Provide number of reserved seats: ";
    cin >> reserved;

    FlightBooking booking(1, capacity, reserved);

    string command;

    cin.ignore();

    while (command != "quit") {
        booking.printStatus();

        getline(cin, command);

        if (command == "quit")
            break;

        string action;
        int value;

        size_t pos = command.find(' ');

        action = command.substr(0, pos);
        value = stoi(command.substr(pos + 1));

        bool result = false;

        if (action == "add")
            result = booking.reserveSeats(value);
        else if (action == "cancel")
            result = booking.cancelReservations(value);

        if (!result)
            cout << "Cannot perform this operation" << endl;
    }

    return 0;
}
