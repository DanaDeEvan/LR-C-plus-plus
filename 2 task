#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));

    int rows = 3;
    int cols = 3;

    int** arr = new int*[rows];

    for (int i = 0; i < rows; i++) {
        arr[i] = new int[cols];
    }

    int even = 0;
    int odd = 0;

    cout << "Масив:\n";

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            arr[i][j] = rand() % 100;
            cout << arr[i][j] << "\t";

            if (arr[i][j] % 2 == 0)
                even++;
            else
                odd++;
        }
        cout << endl;
    }

    cout << "\nГоловна діагональ: ";

    for (int i = 0; i < rows; i++) {
        cout << arr[i][i] << " ";
    }

    cout << "\nПобічна діагональ: ";

    for (int i = 0; i < rows; i++) {
        cout << arr[i][cols - 1 - i] << " ";
    }

    cout << "\nКількість парних елементів: " << even << endl;
    cout << "Кількість непарних елементів: " << odd << endl;

    for (int i = 0; i < rows; i++) {
        delete[] arr[i];
    }

    delete[] arr;

    return 0;
}
